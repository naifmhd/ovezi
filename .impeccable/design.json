  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Mint action; native minimum height 52 and busy/disabled state.",
      "html": "<button class=\"ds-primary\">Save expense</button>",
      "css": ".ds-primary{font-family:system-ui,-apple-system,BlinkMacSystemFont,Roboto,sans-serif;min-height:52px;padding:14px 18px;border:0;border-radius:14px;background:#00F5A0;color:#0A1128;font-size:16px;font-weight:600;cursor:pointer;transition:opacity 100ms,transform 100ms}.ds-primary:disabled{opacity:.65;cursor:default}.ds-primary:hover{opacity:.9}.ds-primary:focus-visible{outline:2px solid #006A50;outline-offset:3px}.ds-primary:active{opacity:.82;transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-primary:active{transform:none}}"
    },
    {
      "name": "Header action",
      "kind": "button",
      "refersTo": "header-action",
      "description": "48-point action target, used for the expense Edit control.",
      "html": "<button class=\"ds-header\">Edit</button>",
      "css": ".ds-header{font-family:system-ui,-apple-system,BlinkMacSystemFont,Roboto,sans-serif;min-width:48px;min-height:48px;padding:10px 0;background:transparent;border:0;color:#006A50;font-size:16px;cursor:pointer}.ds-header:hover{opacity:.9}.ds-header:focus-visible{outline:2px solid #006A50;outline-offset:3px}.ds-header:active{opacity:.82;transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-header:active{transform:none}}@media(prefers-color-scheme:dark){.ds-header{color:#70E8BF}}"
    },
    {
      "name": "Labelled field",
      "kind": "input",
      "refersTo": "form-field",
      "description": "Opaque field with visible label and control border; browser focus ring is a preview affordance.",
      "html": "<label class=\"ds-field\"><span>Email</span><input type=\"email\" placeholder=\"you@example.com\" /></label>",
      "css": ".ds-field{font-family:system-ui,-apple-system,BlinkMacSystemFont,Roboto,sans-serif;display:grid;gap:7px;color:#58685F;font-size:13px;line-height:20px;font-weight:500}.ds-field input{font-family:system-ui,-apple-system,BlinkMacSystemFont,Roboto,sans-serif;box-sizing:border-box;height:54px;min-height:54px;padding:0 16px;border:1px solid #7A8B84;border-radius:14px;background:#FFFFFF;color:#0A1128;font-size:16px}.ds-field input::placeholder{color:#58685F}.ds-field input:hover{border-color:#006A50}.ds-field input:focus-visible{outline:2px solid #006A50;outline-offset:2px}@media(prefers-color-scheme:dark){.ds-field{color:#B4BFCE}.ds-field input{background:#172231;color:#F5F7FC;border-color:#687F96}.ds-field input::placeholder{color:#B4BFCE}}"
    },
    {
      "name": "Choice chip",
      "kind": "chip",
      "refersTo": "choice-chip",
      "description": "48-point choice control with explicit selected state.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"false\">Equal split</button>",
      "css": ".ds-chip{font-family:system-ui,-apple-system,BlinkMacSystemFont,Roboto,sans-serif;min-height:48px;max-width:100%;padding:12px 15px;border:1px solid #7A8B84;border-radius:24px;background:#FFFFFF;color:#0A1128;font-size:13px;line-height:20px;font-weight:600;cursor:pointer}.ds-chip:hover{opacity:.9}.ds-chip:focus-visible{outline:2px solid #006A50;outline-offset:3px}.ds-chip:active{opacity:.82;transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-chip:active{transform:none}}@media(prefers-color-scheme:dark){.ds-chip{background:#172231;color:#F5F7FC;border-color:#687F96}}"
    },
    {
      "name": "Selected choice",
      "kind": "chip",
      "refersTo": "choice-chip-selected",
      "description": "48-point choice control with explicit selected state.",
      "html": "<button class=\"ds-chip-selected\" aria-pressed=\"true\">Equal split</button>",
      "css": ".ds-chip-selected{font-family:system-ui,-apple-system,BlinkMacSystemFont,Roboto,sans-serif;min-height:48px;max-width:100%;padding:12px 15px;border:1px solid #006A50;border-radius:24px;background:#E2F2EB;color:#006A50;font-size:13px;line-height:20px;font-weight:600;cursor:pointer}.ds-chip-selected:hover{opacity:.9}.ds-chip-selected:focus-visible{outline:2px solid #006A50;outline-offset:3px}.ds-chip-selected:active{opacity:.82;transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-chip-selected:active{transform:none}}@media(prefers-color-scheme:dark){.ds-chip-selected{background:#1B3833;color:#70E8BF;border-color:#70E8BF}}"
    },
    {
      "name": "Balance panel",
      "kind": "card",
      "refersTo": "balance-panel",
      "description": "Stable mint-tonal summary; currency remains explicit and amount stays neutral. Synthetic value.",
      "html": "<section class=\"ds-balance\" aria-label=\"You are owed MVR 1,250.00\"><div class=\"ds-balance-label\">You are owed</div><div class=\"ds-balance-currency\">MVR</div><div class=\"ds-balance-amount\">1,250.00</div></section>",
      "css": ".ds-balance{font-family:system-ui,-apple-system,BlinkMacSystemFont,Roboto,sans-serif;padding:22px;border-radius:20px;background:#E2F2EB;color:#0A1128}.ds-balance-label{font-size:15px;line-height:22px;font-weight:500;margin-bottom:12px}.ds-balance-currency{color:#58685F;font-size:13px;line-height:20px;margin-bottom:4px}.ds-balance-amount{font-size:42px;line-height:52px;font-weight:500;letter-spacing:-1.2px;font-variant-numeric:tabular-nums;overflow-x:auto;white-space:nowrap}@media(prefers-color-scheme:dark){.ds-balance{background:#1B3833;color:#F5F7FC}.ds-balance-currency{color:#B4BFCE}}"
    },
    {
      "name": "Add expense action",
      "kind": "button",
      "refersTo": "add-expense",
      "description": "Icon-only task action with an Add expense accessibility label and 56-by-56-point target. Shown with iOS/web corners; Android uses 16-point corners and elevation 3.",
      "html": "<button class=\"ds-add\" aria-label=\"Add expense\"><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-add{font-family:system-ui,-apple-system,BlinkMacSystemFont,Roboto,sans-serif;display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;padding:0;border:0;border-radius:28px;background:#00F5A0;color:#0A1128;font-size:15px;line-height:22px;font-weight:600;box-shadow:0 4px 10px rgba(10,17,40,.1);cursor:pointer}.ds-add:hover{opacity:.9}.ds-add:focus-visible{outline:2px solid #006A50;outline-offset:3px}.ds-add:active{opacity:.82;transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-add:active{transform:none}}"
    },
    {
      "name": "Web navigation reference",
      "kind": "nav",
